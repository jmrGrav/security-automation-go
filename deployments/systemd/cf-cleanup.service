[Unit]
Description=Security Automation Go - Cloudflare Cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/security-automation-go/cf-cleanup.env
WorkingDirectory=/opt/security-automation-go
ExecStart=/opt/security-automation-go/bin/cf-cleanup
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
