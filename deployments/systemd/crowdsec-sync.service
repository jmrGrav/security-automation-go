[Unit]
Description=Security Automation Go - CrowdSec Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/security-automation-go/security-automation.env
WorkingDirectory=/var/lib/security-automation-go
ExecStart=/usr/local/bin/crowdsec-sync
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/lib/security-automation-go /var/log/crowdsec /etc/security-automation-go/secrets

[Install]
WantedBy=multi-user.target
