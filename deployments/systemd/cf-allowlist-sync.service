[Unit]
Description=Security Automation Go - Cloudflare Allowlist Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/security-automation-go/security-automation.env
WorkingDirectory=/var/lib/security-automation-go
ExecStart=/usr/local/bin/cf-allowlist-sync
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/lib/security-automation-go

[Install]
WantedBy=multi-user.target
