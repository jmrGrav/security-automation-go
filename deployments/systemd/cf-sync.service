[Unit]
Description=Cloudflare to CrowdSec Reconciliation Daemon
After=network.target crowdsec.service
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# User identity — must match packaging (postinst/sysusers.d/tmpfiles.d)
User=security-automation
Group=security-automation
# Security Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
DeviceAllow=/dev/null rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

EnvironmentFile=-/etc/security-automation-go/security-automation.env
Environment=STATE_DIR=/var/lib/security-automation-go
ExecStart=/usr/local/bin/cf-sync -mode ui

# Paths (writable)
ReadWritePaths=/var/lib/security-automation-go /var/log/security-automation-go

# Reliability
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
