# /etc/security-automation-go/security-automation.env
# Copy this file to /etc/security-automation-go/security-automation.env,
# set permissions 600 root:root, and fill in real values.
# Lines beginning with # are ignored. Values in double quotes have quotes stripped.
# Variables already set in the process environment take precedence over this file.

# --------------------------------------------------------------------------
# Cloudflare
# --------------------------------------------------------------------------
CF_API_TOKEN=
CF_ZONE_ID=

# --------------------------------------------------------------------------
# Admin API token (CF Sync API)
# --------------------------------------------------------------------------
CF_SYNC_API_TOKEN=

# --------------------------------------------------------------------------
# UI and Metrics (ports chosen to avoid Cockpit/Prometheus conflicts)
# --------------------------------------------------------------------------
# UI_ENABLED=1
# UI_ADDR=127.0.0.1:9091
# METRICS_ADDR=127.0.0.1:9092

# --------------------------------------------------------------------------
# Path and Environment
# --------------------------------------------------------------------------
# STATE_DIR=/var/lib/security-automation-go
