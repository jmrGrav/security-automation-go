# /etc/security-automation/security-automation.env
# Copy this file to /etc/security-automation/security-automation.env,
# set permissions 600 root:root, and fill in real values.
# Lines beginning with # are ignored. Values in double quotes have quotes stripped.
# Variables already set in the process environment take precedence over this file.

# --------------------------------------------------------------------------
# Cloudflare
# --------------------------------------------------------------------------
CF_API_TOKEN=
CF_ZONE_ID=

# --------------------------------------------------------------------------
# Admin API token (CF Sync API)
# --------------------------------------------------------------------------
CF_SYNC_API_TOKEN=

# --------------------------------------------------------------------------
# UI bind address / port overrides (leave blank to use values from config.yaml)
# --------------------------------------------------------------------------
# SECURITY_AUTOMATION_BIND_ADDR=127.0.0.1
# SECURITY_AUTOMATION_WEB_PORT=9091

# --------------------------------------------------------------------------
# Initial admin password — used ONLY if no credential file exists yet.
# After first boot this value is ignored; change the password via the UI.
# --------------------------------------------------------------------------
SECURITY_AUTOMATION_INITIAL_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_BOOT

# --------------------------------------------------------------------------
# AbuseIPDB (optional)
# --------------------------------------------------------------------------
# ABUSEIPDB_KEY=
