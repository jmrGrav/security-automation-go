# cf-shadow environment file — shadow mode validator
# Copy to /etc/security-automation-go/cf-shadow.env and fill in values.
# These are the same credentials as the Python daemon (read-only access).

# ── Cloudflare (read-only for shadow mode) ────────────────────────────────────
# The shadow daemon reads CF rules but NEVER writes. Same token as Python.
CF_API_TOKEN=your-cloudflare-api-token-here
CF_ZONE_ID=your-zone-id-here

# ── CrowdSec (cscli — read-only: decisions list, allowlist inspect) ───────────
# Optional: used for ListRecentBans (decisions.log path)
DECISIONS_LOG=/var/log/crowdsec/decisions.log
NGINX_LOG_DIR=/var/log/nginx

# ── Shadow mode reports ───────────────────────────────────────────────────────
SHADOW_REPORT_DIR=/var/lib/cf-sync/shadow

# ── AbuseIPDB (optional — shadow mode does not report) ───────────────────────
# Set to disable reporting in shadow mode (Go should NOT report to AbuseIPDB
# in shadow mode — Python is already reporting).
ABUSEIPDB_REPORTING_ENABLED=false

# ── State directory ───────────────────────────────────────────────────────────
STATE_DIR=/var/lib/cf-sync

# ── Interval (match Python's cycle time for accurate comparison) ──────────────
# Python RECONCILE_SECS = 300 (5 min). Use 60s for finer-grained measurement.
# CF_RECONCILE_SECS=60  # set via config YAML instead
