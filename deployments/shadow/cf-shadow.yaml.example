version: v1

global:
  service_name: cf-shadow
  log:
    level: info
    format: json

crowdsec:
  decisions_log: /var/log/crowdsec/decisions.log
  nginx_log_dir: /var/log/nginx
  bin_path: cscli
  timeout: 15s
  allowlist_name: my_allowlist

# Match Python's reconcile interval for accurate comparison.
# Python RECONCILE_SECS defaults to 300 (5 min).
# Use 60s for finer-grained shadow measurement.
interval: 60s

state_dir: /var/lib/cf-sync
