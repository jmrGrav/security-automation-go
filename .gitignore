# Build artifacts
/bin/
*.exe
*.test
*.out

# Local environment / secrets — NEVER commit real tokens
*.env
!*.env.example
!configs/ai-providers.example.env
.env.*
!.env.example
# Test fixtures use placeholder-only .env files and must be tracked
!internal/compat/python36/testdata/*.env

# Runtime state / data
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
/var/
# Generated runtime state dir at repo root only — anchored so it never
# matches Go source packages such as internal/state or internal/runtime/state
/state/
*.state.json

# Coverage / profiling
coverage.txt
coverage.html
*.prof
cpu.out
mem.out

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Go workspace
go.work
go.work.sum
