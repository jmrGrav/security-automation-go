#!/bin/sh
set -e

# Create system user and group
if ! getent group security-automation >/dev/null 2>&1; then
    groupadd --system security-automation
fi
if ! getent passwd security-automation >/dev/null 2>&1; then
    useradd --system --no-create-home --gid security-automation \
        --home /var/lib/security-automation-go \
        --shell /usr/sbin/nologin \
        security-automation
fi

# /run/crowdsec-lua is owned root:www-data 775 — the WAF Lua bundle (running
# as www-data under nginx/openresty) writes events.jsonl and waf_refs.jsonl
# there. Without group membership the daemon cannot rename/read files in
# that directory (root:www-data 775 denies "other"). Idempotent; skip if the
# www-data group doesn't exist on this host (e.g. no local nginx/openresty).
if getent group www-data >/dev/null 2>&1; then
    usermod -aG www-data security-automation || true
fi

# Create directories
# /etc/security-automation-go/ root — bootstrap-only non-secret config
install -d -m 755 -o root -g root \
    /etc/security-automation-go
# /var/lib — daemon state directory and runtime credential state
install -d -m 750 -o security-automation -g security-automation \
    /var/lib/security-automation-go \
    /var/lib/security-automation-go/runtime
# /var/log — application logs
install -d -m 755 -o security-automation -g security-automation \
    /var/log/security-automation-go

# Create default env file if it doesn't exist or is empty
if [ ! -s /etc/security-automation-go/security-automation.env ]; then
    cat > /etc/security-automation-go/security-automation.env <<'EOF'
UI_ENABLED=1
UI_ADDR=127.0.0.1:9091
METRICS_ADDR=127.0.0.1:9092
STATE_DIR=/var/lib/security-automation-go
EOF
    chmod 0644 /etc/security-automation-go/security-automation.env
    chown root:root /etc/security-automation-go/security-automation.env
fi

# Remove legacy /etc/systemd/system/cf-sync.service that overrides the package-owned
# /lib/systemd/system/ version. Safe because it is a file we own, not an admin override.
if [ -f /etc/systemd/system/cf-sync.service ]; then
    rm -f /etc/systemd/system/cf-sync.service
fi

# Enable and start service
if [ "$1" = "configure" ]; then
    systemctl daemon-reload || true
    systemctl enable cf-sync.service || true
fi
