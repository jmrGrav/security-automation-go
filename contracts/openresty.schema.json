{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-automation-go.local/contracts/openresty.schema.json",
  "title": "OpenResty Adapter Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service_name",
    "lua_package_path",
    "shared_dicts",
    "init_modules",
    "status_endpoint"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "service_name": {
      "type": "string",
      "minLength": 1
    },
    "lua_package_path": {
      "type": "string",
      "minLength": 1
    },
    "shared_dicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size_bytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "init_modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "worker_sync_enabled": {
      "type": "boolean"
    },
    "status_endpoint": {
      "type": "string",
      "minLength": 1
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
