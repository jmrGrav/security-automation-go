{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-automation-go.local/contracts/events.schema.json",
  "title": "Security Automation Event Contract",
  "description": "Versioned contract for adapter-to-runtime event envelopes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "event_type",
    "scope_id",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
