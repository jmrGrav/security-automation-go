{
  "schema_version": "v1",
  "service_name": "openresty-edge",
  "lua_package_path": "/etc/openresty/lua/?.lua;;",
  "shared_dicts": [
    {
      "name": "cscf_verdicts",
      "size_bytes": 52428800
    },
    {
      "name": "crowdsec_metrics",
      "size_bytes": 10485760
    },
    {
      "name": "crowdsec_state",
      "size_bytes": 5242880
    }
  ],
  "init_modules": [
    "crowdsec.init",
    "crowdsec.lookup",
    "crowdsec.sync"
  ],
  "worker_sync_enabled": true,
  "status_endpoint": "http://127.0.0.1:8091/crowdsec-status",
  "includes": [
    "/etc/nginx/snippets/crowdsec_access.conf",
    "/etc/nginx/snippets/crowdsec_status.conf"
  ]
}
