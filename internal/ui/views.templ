package ui

templ LoginPage(errorText string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Operator Login</title>
			<style>
				body { font-family: system-ui, sans-serif; margin: 0; background: #f5f7fb; color: #10243e; }
				main { max-width: 28rem; margin: 8vh auto; background: white; border: 1px solid #d8e1ef; border-radius: 8px; padding: 1.25rem; box-shadow: 0 1px 2px rgba(16,36,62,.06); }
				label { display: block; margin: .5rem 0 .25rem; }
				input { width: 100%; box-sizing: border-box; padding: .7rem .8rem; border: 1px solid #c9d5e5; border-radius: 6px; }
				button { margin-top: .75rem; padding: .65rem .9rem; border: 0; border-radius: 6px; background: #185adb; color: white; }
				.error { color: #9b1c1c; }
			</style>
		</head>
		<body>
			<main>
				<h1>Local operator access</h1>
				if errorText != "" {
					<p class="error">{ errorText }</p>
				}
				<form action="/login" method="post">
					<label for="password">Password</label>
					<input id="password" name="password" type="password" autocomplete="current-password"/>
					<button type="submit">Sign in</button>
				</form>
			</main>
		</body>
	</html>
}

