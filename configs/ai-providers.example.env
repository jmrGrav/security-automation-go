AI_EXPLAIN_ENABLED=false
AI_EXPLAIN_PROVIDER_STRATEGY=auto

AI_PROVIDER_OPENAI_ENABLED=false
AI_PROVIDER_OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER_OPENAI_API_KEY_FILE=/etc/security-automation-go/secrets/openai_api_key

AI_PROVIDER_ANTHROPIC_ENABLED=false
AI_PROVIDER_ANTHROPIC_MODEL=claude-sonnet-4-6
AI_PROVIDER_ANTHROPIC_API_KEY_FILE=/etc/security-automation-go/secrets/anthropic_api_key

AI_PROVIDER_GEMINI_ENABLED=false
AI_PROVIDER_GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER_GEMINI_API_KEY_FILE=/etc/security-automation-go/secrets/gemini_api_key
