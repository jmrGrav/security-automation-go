# crowdsec-sync example environment
APP_ENV=production
LOG_FORMAT=json
LOG_LEVEL=info

SERVICE_NAME=crowdsec-sync
SERVICE_INTERVAL=60s

CF_API_TOKEN=
CF_ZONE_ID=
CS_API_KEY=
ABUSEIPDB_KEY=
BETTERSTACK_TOKEN=

STATE_DIR=/var/lib/security-automation-go/crowdsec-sync
DECISIONS_LOG=/var/log/crowdsec/decisions.log
NGINX_ERROR_LOG=/var/log/nginx/error.log
NGINX_LOG_DIR=/var/log/nginx

HTTP_TIMEOUT=15s
HTTP_RETRY_MAX=3
HTTP_RETRY_BACKOFF=1s
