# cf-allowlist-sync example environment
APP_ENV=production
LOG_FORMAT=json
LOG_LEVEL=info

SERVICE_NAME=cf-allowlist-sync
CF_API_TOKEN=
CF_ZONE_ID=
CF_LIST_NAME=allowed_ip
CROWDSEC_ALLOWLIST=my_allowlist
EXCLUDE_FROM_CS_SYNC=immuniweb

BETTERSTACK_IPS_URL=https://uptime.betterstack.com/ips.txt
CLOUDFLARE_IPV4_URL=https://www.cloudflare.com/ips-v4/
CLOUDFLARE_IPV6_URL=https://www.cloudflare.com/ips-v6/

HTTP_TIMEOUT=15s
HTTP_RETRY_MAX=3
HTTP_RETRY_BACKOFF=1s
