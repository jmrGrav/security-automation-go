# Core runtime
CF_API_TOKEN=
CF_ZONE_ID=
STATE_DIR=/var/lib/cf-sync
RUNTIME_PROFILE=single-node

# UI
UI_ENABLED=0
UI_ADDR=127.0.0.1:9090
UI_MUTATIONS_ENABLED=0
UI_SECRET_FILE=/var/lib/cf-sync/secrets.local

# Cloudflare mutation toggle
CLOUDFLARE_MUTATIONS_ENABLED=0

# Enrichment
ENRICHMENT_ENABLED=1
ENRICHMENT_DNS_ENABLED=1
ENRICHMENT_ASN_ENABLED=1
ENRICHMENT_TIMEOUT_MS=800
ENRICHMENT_CACHE_TTL=6h

# Providers
ABUSEIPDB_ENABLED=0
ABUSEIPDB_KEY=
SPAMHAUS_ENABLED=0
SPAMHAUS_API_KEY=
VIRUSTOTAL_ENABLED=0
VIRUSTOTAL_API_KEY=

# Optional existing runtime inputs
CS_API_KEY=
DECISIONS_LOG=/var/log/crowdsec/decisions.log
NGINX_LOG_DIR=/var/log/nginx
LUA_EVENTS_FILE=/run/crowdsec-lua/events.jsonl
